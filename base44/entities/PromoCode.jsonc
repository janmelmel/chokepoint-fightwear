{
  "name": "PromoCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ],
      "default": "percentage"
    },
    "discount_value": {
      "type": "number"
    },
    "min_order_amount": {
      "type": "number",
      "default": 0
    },
    "usage_limit": {
      "type": "number"
    },
    "per_user_limit": {
      "type": "number",
      "default": 1
    },
    "usage_count": {
      "type": "number",
      "default": 0
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "discount_type",
    "discount_value"
  ]
}